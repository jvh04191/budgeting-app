# Template only. The real file is ~/.kept/.env (outside the project, Dropbox and git); never commit it.
# Get keys at https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake banks, free) or production (real banks; needs Plaid production approval)
PLAID_ENV=sandbox
# Encrypts bank access tokens in the database. Generate with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Keep it safe: if you lose it, linked banks must be re-linked.
TOKEN_ENCRYPTION_KEY=
# Only needed for OAuth banks in production (must be registered in the Plaid dashboard)
# PLAID_REDIRECT_URI=
